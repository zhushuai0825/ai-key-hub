# 通义千问账户余额（阿里云 RAM AccessKey，不是 DashScope API Key）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# 豆包 / 火山账户余额（火山引擎 AccessKey，不是方舟 API Key）
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=

# 可选：余额自动刷新间隔（毫秒），默认 5 分钟
# BALANCE_REFRESH_MS=300000

# Key 管理页登录（仅 keys.html / api/keys；管理员登录后可直接进）
KEY_AUTH_USER=
KEY_AUTH_PASSWORD=

# 全站登录（密码务必用环境变量覆盖，勿把真实密码提交进仓库）
# APP_ADMIN_USER=admin
# APP_ADMIN_PASSWORD=change-me
# 额外普通用户：alice:pass1,bob:pass2
# APP_EXTRA_USERS=
# APP_SESSION_TTL_MS=43200000

# 解密库中已加密的 API Key（与服务器 systemd 中 KEY_ENCRYPTION_SECRET 保持一致）
# 缺失时无法调用 DeepSeek / 网关，会直接报错而不是发出脱敏假 Key
# KEY_ENCRYPTION_SECRET=

# 漫剧识别调用 DeepSeek 超时（毫秒），默认 180000；需小于 nginx proxy_read_timeout
# DRAMA_LLM_TIMEOUT_MS=180000
# 长剧本按集分批：超过该字数且集数>批次大小时启用
# DRAMA_EXTRACT_BATCH_CHARS=10000
# DRAMA_EXTRACT_BATCH_EPS=4
